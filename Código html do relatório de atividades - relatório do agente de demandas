      </section>

      <!-- INTELIGÊNCIA DE DADOS -->
      <section class="area-section">
        <div class="area-header">Inteligência de Dados</div>

        <article class="colaborador-section">
          <header class="colaborador-header">
            <div class="colaborador-nome">João</div>
            <span class="status-badge {{classe_status_joao}}">{{status_joao}}</span>
          </header>
          <section class="activity-section">
            <h3 class="activity-title">Atividades iniciadas ({{qtd_iniciadas_joao}})</h3>
            {{tabela_iniciadas_joao}}
          </section>
          <section class="activity-section">
            <h3 class="activity-title">Atividades finalizadas ({{qtd_finalizadas_joao}})</h3>
            {{tabela_finalizadas_joao}}
          </section>
        </article>

        <article class="colaborador-section">
          <header class="colaborador-header">
            <div class="colaborador-nome">Rafael Akira</div>
            <span class="status-badge {{classe_status_rafael}}">{{status_rafael}}</span>
          </header>
          <section class="activity-section">
            <h3 class="activity-title">Atividades iniciadas ({{qtd_iniciadas_rafael}})</h3>
            {{tabela_iniciadas_rafael}}
          </section>
          <section class="activity-section">
            <h3 class="activity-title">Atividades finalizadas ({{qtd_finalizadas_rafael}})</h3>
            {{tabela_finalizadas_rafael}}
          </section>
        </article>
      </section>

      <!-- ALUGUÉIS -->
      <section class="area-section">
        <div class="area-header">Aluguéis</div>

        <article class="colaborador-section">
          <header class="colaborador-header">
            <div class="colaborador-nome">Daiane</div>
            <span class="status-badge {{classe_status_daiane}}">{{status_daiane}}</span>
          </header>
          <section class="activity-section">
            <h3 class="activity-title">Atividades iniciadas ({{qtd_iniciadas_daiane}})</h3>
            {{tabela_iniciadas_daiane}}
          </section>
          <section class="activity-section">
            <h3 class="activity-title">Atividades finalizadas ({{qtd_finalizadas_daiane}})</h3>
            {{tabela_finalizadas_daiane}}
          </section>
        </article>

        <article class="colaborador-section">
          <header class="colaborador-header">
            <div class="colaborador-nome">Heloisa</div>
            <span class="status-badge {{classe_status_heloisa}}">{{status_heloisa}}</span>
          </header>
          <section class="activity-section">
            <h3 class="activity-title">Atividades iniciadas ({{qtd_iniciadas_heloisa}})</h3>
            {{tabela_iniciadas_heloisa}}
          </section>
          <section class="activity-section">
            <h3 class="activity-title">Atividades finalizadas ({{qtd_finalizadas_heloisa}})</h3>
            {{tabela_finalizadas_heloisa}}
          </section>
        </article>
      </section>

      <!-- CONTRATOS CORPORATIVOS -->
      <section class="area-section">
        <div class="area-header">Contratos Corporativos</div>

        <article class="colaborador-section">
          <header class="colaborador-header">
            <div class="colaborador-nome">Fabielly</div>
            <span class="status-badge {{classe_status_fabielly}}">{{status_fabielly}}</span>
          </header>
          <section class="activity-section">
            <h3 class="activity-title">Atividades iniciadas ({{qtd_iniciadas_fabielly}})</h3>
            {{tabela_iniciadas_fabielly}}
          </section>
          <section class="activity-section">
            <h3 class="activity-title">Atividades finalizadas ({{qtd_finalizadas_fabielly}})</h3>
            {{tabela_finalizadas_fabielly}}
          </section>
        </article>
      </section>

      <section class="pendencias">
        <h2>Pendências de preenchimento</h2>
        {{tabela_pendencias}}
      </section>
    </section>

    <footer class="footer">
      <strong>Acompanhamento de Atividades Diárias</strong><br>
      Gazin Grupo Empresarial
      <div class="rodape-data">
        Gerado automaticamente em {{data_hora_geracao}}<br>
        Este é um relatório automático.
      </div>
    </footer>
  </main>
</body>
</html>


